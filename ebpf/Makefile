# ebpf/Makefile — Build eBPF programs and run bpf2go codegen.
#
# Requires:
#   clang >= 14, llvm-strip, bpftool (for btf dump)
#   go install github.com/cilium/ebpf/cmd/bpf2go@latest
#   Kernel headers in /usr/include/asm / vmlinux.h (generated by bpftool)

CLANG     ?= clang
STRIP     ?= llvm-strip
ARCH      ?= $(shell uname -m | sed 's/x86_64/x86/' | sed 's/aarch64/arm64/')
CFLAGS    := -O2 -g -Wall -Werror -target bpf -D__TARGET_ARCH_$(ARCH) \
             -I/usr/include/$(shell uname -m)-linux-gnu \
             -I/usr/include

BPF_SRCS  := edac_trace.bpf.c workload_attr.bpf.c
BPF_OBJS  := $(BPF_SRCS:.bpf.c=.bpf.o)

.PHONY: all generate clean vmlinux verify

all: vmlinux $(BPF_OBJS) generate

vmlinux: vmlinux.h
vmlinux.h:
	@echo "Generating vmlinux.h from running kernel BTF..."
	bpftool btf dump file /sys/kernel/btf/vmlinux format c > vmlinux.h
	@echo "vmlinux.h: generated ($(shell wc -l < vmlinux.h) lines)"

%.bpf.o: %.bpf.c vmlinux.h
	$(CLANG) $(CFLAGS) -c $< -o $@
	$(STRIP) -g $@
	@echo "Compiled: $@"

generate: $(BPF_OBJS)
	@echo "Running bpf2go codegen for Go bindings..."
	cd ../exporter && go generate ./collectors/
	@echo "bpf2go: generated *_bpf*.go files"

verify: $(BPF_OBJS)
	@for obj in $(BPF_OBJS); do \
	    echo "Verifying $$obj..."; \
	    bpftool prog load $$obj /sys/fs/bpf/test_$$obj 2>&1 || true; \
	    rm -f /sys/fs/bpf/test_$$obj; \
	done

clean:
	rm -f $(BPF_OBJS) vmlinux.h
	rm -f ../exporter/collectors/*_bpf*.go
