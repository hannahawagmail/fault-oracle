# SPDX-License-Identifier: Apache-2.0
# uboot-bootcount.env — U-Boot environment for bootcount-based A/B failover
#
# Load via:
#   fw_setenv -s uboot-bootcount.env
#
# Or embed in board defconfig:
#   CONFIG_BOOTCOUNT_LIMIT=y
#   CONFIG_BOOTCOUNT_ENV=y
#   CONFIG_BOOTLIMIT=3
#
# Board assumptions:
#   - eMMC at /dev/mmcblk0
#   - rootfs-A at partition 2 (mmcblk0p2), rootfs-B at partition 3 (mmcblk0p3)
#   - FAT boot partition at mmcblk0p1 (holds FIT images: kernel-a.itb, kernel-b.itb)
#   - U-Boot environment stored at mmcblk0 offset 0x3F0000 (4MB - 64KB)
#
# Adjust mmcdev, mmcpart, boot_part_* for your hardware.
#
# -------------------------------------------------------------------------
# Slot state tracking
# -------------------------------------------------------------------------

# Current active boot slot (A or B)
bootslot=A

# Per-slot state: active | pending | failed | standby
slot_a_state=active
slot_b_state=standby

# -------------------------------------------------------------------------
# Bootcount failover parameters
# -------------------------------------------------------------------------

# Maximum boot attempts before falling back (altbootcmd runs when bootcount >= bootlimit)
bootlimit=3

# bootcount starts at 0 and is incremented automatically by U-Boot on each boot.
# It is reset to 0 by the Linux userspace after a confirmed successful boot.
# (Do not set bootcount here — U-Boot manages it automatically when CONFIG_BOOTCOUNT_LIMIT=y)
bootcount=0

# -------------------------------------------------------------------------
# eMMC device configuration
# -------------------------------------------------------------------------

# eMMC device index (0 = first MMC device)
mmcdev=0

# Partition holding FIT images (kernel + DTB in FIT format)
boot_mmcpart=1

# rootfs partition numbers
part_a=2
part_b=3

# FIT image file names on the boot FAT partition
fitimage_a=kernel-a.itb
fitimage_b=kernel-b.itb

# Persistent data partition (mounted at /data, survives OTA updates)
data_part=4

# -------------------------------------------------------------------------
# Kernel boot arguments — common to both slots
# -------------------------------------------------------------------------

# Common args: use overlayfs for writable layer, enable earlycon for debug
bootargs_common=earlycon console=ttyAMA0,115200 loglevel=4 rootwait rootfstype=ext4

# Slot A kernel arguments: root on partition 2
bootargs_a=${bootargs_common} root=/dev/mmcblk0p2 ro

# Slot B kernel arguments: root on partition 3
bootargs_b=${bootargs_common} root=/dev/mmcblk0p3 ro

# -------------------------------------------------------------------------
# Main boot command (executed when bootcount < bootlimit)
# -------------------------------------------------------------------------
#
# Logic:
#   1. Select fit image and bootargs based on bootslot variable
#   2. Load FIT image from eMMC FAT partition
#   3. Boot (bootm verifies FIT signature if CONFIG_FIT_SIGNATURE=y)
#
bootcmd=run select_slot; run load_fit; run boot_fit

# Select active slot variables based on bootslot
select_slot=if test "${bootslot}" = "A"; then setenv fitimage ${fitimage_a}; setenv bootargs ${bootargs_a}; setenv root_part ${part_a}; else setenv fitimage ${fitimage_b}; setenv bootargs ${bootargs_b}; setenv root_part ${part_b}; fi

# Load FIT image from FAT partition into memory at $loadaddr
load_fit=mmc dev ${mmcdev}; fatload mmc ${mmcdev}:${boot_mmcpart} ${loadaddr} ${fitimage}

# Boot the loaded FIT image (bootm verifies signatures when CONFIG_FIT_SIGNATURE=y)
# Using fitconfig selects the configuration matching the current DTB
boot_fit=bootm ${loadaddr}#conf-1

# -------------------------------------------------------------------------
# Fallback command (executed when bootcount >= bootlimit)
# -------------------------------------------------------------------------
#
# altbootcmd is executed instead of bootcmd when the boot attempt limit is reached.
#
# Logic:
#   1. Mark current slot as failed
#   2. Switch to the other slot
#   3. Reset bootcount to 0
#   4. Save environment
#   5. Boot the fallback slot
#
altbootcmd=run ab_fallback; run select_slot; run load_fit; run boot_fit

# A/B fallback logic:
#   - If bootslot is A and slot_a_state != failed: mark A failed, switch to B
#   - If bootslot is B and slot_b_state != failed: mark B failed, switch to A
#   - Reset bootcount so the new slot gets a fresh 3 tries
ab_fallback=if test "${bootslot}" = "A"; then setenv slot_a_state failed; setenv bootslot B; setenv slot_b_state pending; else setenv slot_b_state failed; setenv bootslot A; setenv slot_a_state pending; fi; setenv bootcount 0; saveenv; echo "FALLBACK: switched to slot ${bootslot}"

# -------------------------------------------------------------------------
# verify_boot — called by Linux init after successful userspace startup
# -------------------------------------------------------------------------
#
# This command is triggered by the Linux-side script:
#   ab-partition-setup.sh --mark-active <slot>
# which calls:
#   fw_setenv bootcount 0
#   fw_setenv slot_X_state active
#
# The verify_boot env snippet here is informational — it shows the equivalent
# U-Boot command you could run from the U-Boot console for testing.
#
verify_boot=setenv bootcount 0; if test "${bootslot}" = "A"; then setenv slot_a_state active; setenv slot_b_state standby; else setenv slot_b_state active; setenv slot_a_state standby; fi; saveenv; echo "Boot verified for slot ${bootslot}"

# -------------------------------------------------------------------------
# Recovery mode (optional — entered via button GPIO or serial console)
# -------------------------------------------------------------------------
#
# If both slots are failed, attempt recovery boot from USB or TFTP.
# This requires CONFIG_CMD_USB=y or CONFIG_CMD_NET=y.
#
recovery_bootargs=earlycon console=ttyAMA0,115200 root=/dev/sda1 ro rootwait
recoveryboot=echo "Entering recovery mode..."; usb start; fatload usb 0 ${loadaddr} recovery.itb; setenv bootargs ${recovery_bootargs}; bootm ${loadaddr} || run tftpboot_recovery
tftpboot_recovery=setenv ipaddr 192.168.1.100; setenv serverip 192.168.1.1; tftp ${loadaddr} recovery.itb; setenv bootargs ${recovery_bootargs}; bootm ${loadaddr}

# -------------------------------------------------------------------------
# Environment CRC protection
# -------------------------------------------------------------------------
# U-Boot automatically adds crc32 checksums to each environment copy.
# With CONFIG_ENV_REDUNDANT=y, two copies are maintained.
# Do not edit the crc/flags fields manually.
