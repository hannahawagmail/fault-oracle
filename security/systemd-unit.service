# security/systemd-unit.service — Hardened systemd unit for hw-fault-exporter
# on bare-metal ARM64 hosts.
#
# Install:
#   sudo cp security/systemd-unit.service /etc/systemd/system/hw-fault-exporter.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hw-fault-exporter

[Unit]
Description=Hardware Fault Prometheus Exporter
Documentation=https://github.com/hanna-hawa/fault-oracle
After=network.target
Wants=network.target

[Service]
Type=simple
User=hw-fault-exporter
Group=hw-fault-exporter
ExecStart=/usr/local/bin/hw-fault-exporter \
    --listen-addr :9101 \
    --sysfs-root /sys \
    --log-level info \
    --tls-cert /etc/hw-fault-exporter/tls/server.crt \
    --tls-key  /etc/hw-fault-exporter/tls/server.key \
    --tls-ca   /etc/hw-fault-exporter/tls/ca.crt
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bind-mount /sys read-only (the exporter never writes to sysfs)
BindReadOnlyPaths=/sys

# AppArmor profile (applied at exec)
AppArmorProfile=usr.local.bin.hw-fault-exporter

# Capability restrictions — only allow binding ports
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH

# SecureBits — prevent privilege escalation
SecureBits=no-setuid-fixup-locked noroot-locked

[Install]
WantedBy=multi-user.target
