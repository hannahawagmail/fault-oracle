# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=IPMI SDR sensor value exporter (management-plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/hw-fault-bmc/bmc-targets.env
ExecStart=/usr/bin/python3 /usr/local/lib/hw-fault-resilience/bmc/ipmi-sensor-exporter.py \
    --output /var/lib/node_exporter/textfile_collector/ipmi-sensors.prom
User=root
